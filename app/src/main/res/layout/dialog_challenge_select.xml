<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="@dimen/spacing_xl">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xxl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="챌린지 선택 및 친구 초대"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            android:contentDescription="닫기"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/gray_subtext" />
    </RelativeLayout>

    <!-- 그룹 챌린지 목표 섹션 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="그룹 챌린지 목표"
        android:textColor="@color/gray_subtext"
        android:textSize="@dimen/text_sm"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_md"/>

    <!-- 챌린지 옵션 리스트 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xl"
        app:cardBackgroundColor="@color/gray_90"
        app:cardCornerRadius="@dimen/corner_radius_md"
        app:cardElevation="0dp">

        <RadioGroup
            android:id="@+id/rg_challenges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_sm">

            <RadioButton
                android:id="@+id/rb_challenge_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="그룹 총 5kg 감량 챌린지 (1주)"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/text_base"
                android:padding="@dimen/spacing_md"
                android:buttonTint="@color/primary_blue"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rb_challenge_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="일주일간 설탕 음료 끊기 챌린지"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/text_base"
                android:padding="@dimen/spacing_md"
                android:buttonTint="@color/primary_blue"/>

            <RadioButton
                android:id="@+id/rb_challenge_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="매일 1만보 걷고 건강 식단 인증 (10일)"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/text_base"
                android:padding="@dimen/spacing_md"
                android:buttonTint="@color/primary_blue"/>

            <RadioButton
                android:id="@+id/rb_challenge_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="직접 입력"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/text_base"
                android:padding="@dimen/spacing_md"
                android:buttonTint="@color/primary_blue"/>

        </RadioGroup>
    </androidx.cardview.widget.CardView>

    <!-- 직접 입력 필드 (숨김 상태) -->
    <EditText
        android:id="@+id/et_custom_challenge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="챌린지 목표를 입력하세요"
        android:textColorHint="@color/gray_50"
        android:textColor="@color/gray_text"
        android:textSize="@dimen/text_base"
        android:background="@drawable/bg_edit_text"
        android:padding="@dimen/spacing_lg"
        android:inputType="text"
        android:maxLines="1"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/spacing_xl"/>

    <!-- 친구 초대 섹션 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="친구 초대"
        android:textColor="@color/gray_subtext"
        android:textSize="@dimen/text_sm"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_md"/>

    <!-- 친구 리스트 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xxl"
        app:cardBackgroundColor="@color/gray_90"
        app:cardCornerRadius="@dimen/corner_radius_md"
        app:cardElevation="0dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_friends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="200dp"
            android:padding="@dimen/spacing_sm"
            android:nestedScrollingEnabled="false"/>

    </androidx.cardview.widget.CardView>

    <!-- 빈 상태 메시지 (친구가 없을 때) -->
    <TextView
        android:id="@+id/tv_no_friends"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="초대할 수 있는 친구가 없습니다.\n프로필에서 친구를 추가해보세요."
        android:textColor="@color/gray_subtext"
        android:textSize="@dimen/text_sm"
        android:gravity="center"
        android:padding="@dimen/spacing_xl"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/spacing_xxl"/>

    <!-- 생성하기 버튼 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_create"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="+ 생성하기"
        android:textColor="@color/white"
        android:textSize="@dimen/text_md"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:textAllCaps="false"/>

</LinearLayout>
