<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_90">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_lg"
        android:paddingTop="48dp"
        android:background="@color/gray_90">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="뒤로가기"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            app:tint="@color/gray_text"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_md">

            <TextView
                android:id="@+id/tv_group_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="여름 준비 다이어트방"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_group_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="여름까지 함께 달려봐요!"
                android:textColor="@color/gray_subtext"
                android:textSize="@dimen/text_sm"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="메뉴"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            app:tint="@color/gray_subtext"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- 멤버 섹션 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/gray_100"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👥"
                            android:textSize="@dimen/text_md"/>

                        <TextView
                            android:id="@+id/tv_member_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 멤버 (5명)"
                            android:textColor="@color/gray_text"
                            android:textSize="@dimen/text_base"
                            android:textStyle="bold"
                            android:layout_marginStart="@dimen/spacing_xs"/>

                    </LinearLayout>

                    <!-- 멤버 아바타 리스트 -->
                    <LinearLayout
                        android:id="@+id/ll_member_avatars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- 동적으로 추가될 아바타들 -->

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 진행중인 챌린지 섹션 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/gray_100"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯"
                            android:textSize="@dimen/text_md"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 진행중인 챌린지"
                            android:textColor="@color/gray_text"
                            android:textSize="@dimen/text_base"
                            android:textStyle="bold"
                            android:layout_marginStart="@dimen/spacing_xs"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_challenge_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="그룹 칼로리 50,000kcal 소모"
                        android:textColor="@color/gray_text"
                        android:textSize="@dimen/text_base"
                        android:layout_marginBottom="@dimen/spacing_sm"/>

                    <ProgressBar
                        android:id="@+id/progress_challenge"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:progressTint="@color/primary_blue"
                        android:progressBackgroundTint="@color/gray_70"
                        android:progress="78"
                        android:max="100"/>

                    <TextView
                        android:id="@+id/tv_challenge_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="78% 달성"
                        android:textColor="@color/primary_blue"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/spacing_xs"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 그룹 피드 섹션 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="그룹 피드"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <!-- 피드 리스트 또는 빈 상태 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_empty_feed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/gray_100"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="@dimen/card_elevation">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="그룹 활동이 없습니다."
                    android:textColor="@color/gray_subtext"
                    android:textSize="@dimen/text_base"
                    android:gravity="center"
                    android:padding="@dimen/spacing_xxxl"/>

            </androidx.cardview.widget.CardView>

            <!-- 피드 RecyclerView (활동이 있을 때) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_feed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
