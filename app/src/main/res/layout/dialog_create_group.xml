<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="@dimen/spacing_xl">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xxl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="새로운 그룹 만들기"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            android:contentDescription="닫기"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/gray_subtext" />
    </RelativeLayout>

    <!-- 그룹 이름 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="그룹 이름"
        android:textColor="@color/gray_text"
        android:textSize="@dimen/text_base"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_sm"/>

    <EditText
        android:id="@+id/et_group_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="예: 여름 준비 다이어트방"
        android:textColorHint="@color/gray_50"
        android:textColor="@color/gray_text"
        android:textSize="@dimen/text_base"
        android:background="@drawable/bg_edit_text"
        android:padding="@dimen/spacing_lg"
        android:inputType="text"
        android:maxLines="1"
        android:layout_marginBottom="@dimen/spacing_xl"/>

    <!-- 한 줄 설명 (선택) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="한 줄 설명 (선택)"
        android:textColor="@color/gray_text"
        android:textSize="@dimen/text_base"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_sm"/>

    <EditText
        android:id="@+id/et_group_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="예: 함께 목표를 달성해봐요!"
        android:textColorHint="@color/gray_50"
        android:textColor="@color/gray_text"
        android:textSize="@dimen/text_base"
        android:background="@drawable/bg_edit_text"
        android:padding="@dimen/spacing_lg"
        android:inputType="text"
        android:maxLines="1"
        android:layout_marginBottom="@dimen/spacing_xl"/>

    <!-- 그룹 목표 주제 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="그룹 목표 주제"
        android:textColor="@color/gray_text"
        android:textSize="@dimen/text_base"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_sm"/>

    <EditText
        android:id="@+id/et_group_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="예: 건강한 식습관, 다이어트"
        android:textColorHint="@color/gray_50"
        android:textColor="@color/gray_text"
        android:textSize="@dimen/text_base"
        android:background="@drawable/bg_edit_text"
        android:padding="@dimen/spacing_lg"
        android:inputType="text"
        android:maxLines="1"
        android:layout_marginBottom="@dimen/spacing_xxl"/>

    <!-- AI 챌린지 추천받기 버튼 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_ai_challenge"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="✨ AI 챌린지 추천받기"
        android:textColor="@color/white"
        android:textSize="@dimen/text_md"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:textAllCaps="false"/>

</LinearLayout>
