<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_lg"
    android:layout_marginEnd="@dimen/spacing_lg"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardBackgroundColor="@color/gray_100"
    app:cardCornerRadius="@dimen/corner_radius_md"
    app:cardElevation="@dimen/card_elevation">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg">
        
        <!-- Meal Image (optional) -->
        <ImageView
            android:id="@+id/img_meal"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:background="@color/gray_70"
            android:visibility="gone"
            android:contentDescription="식단 이미지"/>
        
        <!-- Meal Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_md">
            
            <!-- Time Badge -->
            <TextView
                android:id="@+id/txt_meal_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아침"
                android:textSize="@dimen/text_xs"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_time_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="@dimen/spacing_xs"/>
            
            <!-- Food Name -->
            <TextView
                android:id="@+id/txt_food_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="닭가슴살 샐러드"
                android:textSize="@dimen/text_md"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:maxLines="1"
                android:ellipsize="end"/>
            
            <!-- Calories and Macros -->
            <TextView
                android:id="@+id/txt_meal_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="350 kcal • 탄 30g • 단 25g • 지 10g"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/gray_subtext"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
        
        <!-- Delete Button -->
        <TextView
            android:id="@+id/btn_delete_meal"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="×"
            android:textSize="24sp"
            android:textColor="@color/gray_subtext"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
