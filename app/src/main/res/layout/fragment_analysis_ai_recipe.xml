<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_90"
    tools:context=".fragments.AnalysisAiRecipeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- AI 주간 운동 플랜 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/corner_radius_lg"
            app:cardElevation="0dp"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏃"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="AI 주간 운동 플랜"
                        android:textColor="@color/gray_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/btn_refresh_exercise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp">

                        <ProgressBar
                            android:id="@+id/progress_exercise"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/ic_refresh_exercise"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_refresh"
                            app:tint="@color/primary_blue" />

                        <TextView
                            android:id="@+id/txt_refresh_exercise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="새로고침"
                            android:textColor="@color/primary_blue"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_exercise_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="아직 운동 플랜이 없습니다."
                    android:textColor="@color/gray_subtext"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/txt_exercise_cooldown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textColor="@color/gray_50"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- AI 맞춤 레시피 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/corner_radius_lg"
            app:cardElevation="0dp"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍳"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="AI 맞춤 레시피"
                        android:textColor="@color/gray_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/btn_refresh_recipe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp">

                        <ProgressBar
                            android:id="@+id/progress_recipe"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/ic_refresh_recipe"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_refresh"
                            app:tint="@color/primary_blue" />

                        <TextView
                            android:id="@+id/txt_refresh_recipe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="다른 레시피 추천"
                            android:textColor="@color/primary_blue"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_recipe_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="레시피를 불러오지 못했습니다."
                    android:textColor="@color/gray_subtext"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/txt_recipe_cooldown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textColor="@color/gray_50"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 냉장고 파먹기 AI 레시피 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/corner_radius_lg"
            app:cardElevation="0dp"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧊"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="냉장고 파먹기 AI 레시피"
                        android:textColor="@color/gray_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_ingredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_edit_text_rounded"
                    android:padding="@dimen/spacing_md"
                    android:hint="가지고 있는 재료를 입력해보세요. (예: 닭가슴살, 양파, 계란, 우유)"
                    android:textColorHint="@color/gray_50"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:maxLines="2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate_fridge_recipe"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="나만의 레시피 생성하기"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:backgroundTint="@color/primary_blue"
                    app:cornerRadius="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="재료를 입력하고 버튼을 누르면 AI가 맞춤 레시피를 만들어드려요!"
                    android:textColor="@color/gray_50"
                    android:textSize="12sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txt_fridge_recipe_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 칼로리 섭취 트렌드 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/corner_radius_lg"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="칼로리 섭취 트렌드"
                        android:textColor="@color/gray_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_period"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_7days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="최근 7일"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@color/chip_background_selector"
                            app:chipStrokeWidth="1dp"
                            app:chipStrokeColor="@color/gray_70"
                            app:checkedIconVisible="false"
                            android:checked="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_30days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="최근 30일"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@color/chip_background_selector"
                            app:chipStrokeWidth="1dp"
                            app:chipStrokeColor="@color/gray_70"
                            app:checkedIconVisible="false" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chart_calorie_trend"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/spacing_md" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
