<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="@dimen/spacing_xl">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="친구 추가"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="닫기"
            app:tint="@color/gray_subtext" />
    </RelativeLayout>

    <!-- Search Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_edit_text_rounded"
        android:padding="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_md">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/gray_subtext" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="친구 닉네임 검색"
            android:textColorHint="@color/gray_subtext"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/text_md"
            android:inputType="textEmailAddress"
            android:imeOptions="actionSearch"
            android:singleLine="true" />

    </LinearLayout>

    <!-- Search Results Header -->
    <TextView
        android:id="@+id/tv_results_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="검색 결과"
        android:textColor="@color/gray_subtext"
        android:textSize="@dimen/text_sm"
        android:layout_marginBottom="@dimen/spacing_sm" />

    <!-- Search Results / Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <!-- Empty State -->
        <TextView
            android:id="@+id/tv_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="검색어를 입력해주세요."
            android:textColor="@color/gray_subtext"
            android:textSize="@dimen/text_base" />

        <!-- Search Results List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
