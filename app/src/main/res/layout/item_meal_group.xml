<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_lg"
    android:layout_marginEnd="@dimen/spacing_lg"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/corner_radius_md"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <!-- Stacked Images Container -->
        <FrameLayout
            android:id="@+id/images_container"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="@dimen/spacing_md">

            <!-- Second image (behind, offset) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_image_back"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="end|bottom"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp">

                <ImageView
                    android:id="@+id/img_meal_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="식단 이미지" />
            </androidx.cardview.widget.CardView>

            <!-- First image (front) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_image_front"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="start|top"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <ImageView
                    android:id="@+id/img_meal_front"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/gray_70"
                    android:contentDescription="식단 이미지" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Meal Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!-- Time Badge -->
            <TextView
                android:id="@+id/txt_meal_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="저녁"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_time_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginBottom="6dp" />

            <!-- Food Names (e.g., "떡볶이, 어묵 외 4개") -->
            <TextView
                android:id="@+id/txt_food_names"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="떡볶이, 어묵 외 4개"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Total Calories and Macros -->
            <TextView
                android:id="@+id/txt_meal_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,580 kcal • 탄 200g • 단 50g • 지 30g"
                android:textSize="12sp"
                android:textColor="@color/gray_subtext"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Delete/Expand Button -->
        <ImageView
            android:id="@+id/btn_expand"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="상세보기"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
