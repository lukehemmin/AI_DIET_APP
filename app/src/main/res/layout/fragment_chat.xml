<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_90">
    
    <!-- Chat Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xxl"
        android:background="@color/gray_90">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_title"
            android:textSize="@dimen/text_xxl"
            android:textStyle="bold"
            android:textColor="@color/gray_text"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_subtitle"
            android:textSize="@dimen/text_base"
            android:textColor="@color/gray_subtext"
            android:layout_marginTop="@dimen/spacing_xs"/>
    </LinearLayout>
    
    <!-- Chat Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/spacing_lg"
        android:clipToPadding="false"/>
    
    <!-- Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        android:background="@color/gray_100"
        android:gravity="center_vertical"
        android:elevation="4dp">
        
        <EditText
            android:id="@+id/et_chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/chat_input_hint"
            android:textSize="@dimen/text_base"
            android:textColor="@color/gray_text"
            android:textColorHint="@color/gray_subtext"
            android:background="@drawable/bg_chat_input"
            android:padding="@dimen/spacing_md"
            android:minHeight="48dp"
            android:maxLines="4"/>
        
        <ImageView
            android:id="@+id/btn_send_message"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_send"
            android:padding="12dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_send_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="전송"/>
    </LinearLayout>
</LinearLayout>
