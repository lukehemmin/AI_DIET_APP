<?xml version="1.0" encoding="utf-8"?>
<!--
 루트 레이아웃을 ConstraintLayout으로 설정하여
 상단 바, 스크롤 영역, 하단 버튼 영역을 분리합니다.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    tools:context=".AnalysisResultActivity">

    <!-- 상단 바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_arrow_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back"
            android:padding="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="뒤로 가기" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="음식 분석"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 하단 버튼 영역 -->
    <LinearLayout
        android:id="@+id/bottom_button_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_retry"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="다시 촬영"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#E0E0E0"
            app:backgroundTint="#F5F5F7" /> <!-- 이미지의 연한 회색 배경 -->

        <Button
            android:id="@+id/btn_add_to_meal"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="식단에 추가"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#007AFF"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- 스크롤 가능한 콘텐츠 영역 -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_button_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. 음식 이름 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- 체크 아이콘 배경 (Drawable 필요) -->
                    <FrameLayout
                        android:id="@+id/icon_background"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/circular_background_light_green"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:id="@+id/iv_check_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check"
                            android:layout_gravity="center"
                            app:tint="#34C759"
                            android:contentDescription="확인" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_food_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="닭가슴살 샐러드"
                        android:textColor="@android:color/black"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toEndOf="@id/icon_background"
                        app:layout_constraintTop_toTopOf="@id/icon_background"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_food_details"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="신뢰도 92% · 250g"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toEndOf="@id/icon_background"
                        app:layout_constraintTop_toBottomOf="@id/tv_food_name"
                        app:layout_constraintBottom_toBottomOf="@id/icon_background"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. 칼로리 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="총 칼로리"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="320"
                            android:textColor="@android:color/black"
                            android:textSize="48sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="kcal"
                            android:textColor="@android:color/darker_gray"
                            android:textSize="20sp"
                            android:layout_marginStart="4dp"
                            android:paddingBottom="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. 영양소 구성 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="영양소 구성"
                        android:textColor="@android:color/black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- 탄수화물 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">

                        <ImageView
                            android:id="@+id/dot_carbs"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/oval_shape_blue"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tv_carbs_label"
                            app:layout_constraintBottom_toBottomOf="@id/tv_carbs_label"
                            android:contentDescription="탄수화물" />

                        <TextView
                            android:id="@+id/tv_carbs_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="탄수화물"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/dot_carbs"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_carbs_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12g"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ProgressBar
                            android:id="@+id/progress_carbs"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="20"
                            android:progressDrawable="@drawable/progress_bar_blue"
                            app:layout_constraintStart_toStartOf="@id/tv_carbs_label"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_carbs_label" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- 단백질 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:id="@+id/dot_protein"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/oval_shape_green"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tv_protein_label"
                            app:layout_constraintBottom_toBottomOf="@id/tv_protein_label"
                            android:contentDescription="단백질" />

                        <TextView
                            android:id="@+id/tv_protein_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="단백질"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/dot_protein"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_protein_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="45g"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ProgressBar
                            android:id="@+id/progress_protein"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="75"
                            android:progressDrawable="@drawable/progress_bar_green"
                            app:layout_constraintStart_toStartOf="@id/tv_protein_label"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_protein_label" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- 지방 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:id="@+id/dot_fat"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/oval_shape_orange"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tv_fat_label"
                            app:layout_constraintBottom_toBottomOf="@id/tv_fat_label"
                            android:contentDescription="지방" />

                        <TextView
                            android:id="@+id/tv_fat_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="지방"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/dot_fat"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_fat_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10g"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ProgressBar
                            android:id="@+id/progress_fat"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="30"
                            android:progressDrawable="@drawable/progress_bar_orange"
                            app:layout_constraintStart_toStartOf="@id/tv_fat_label"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_fat_label" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 스크롤 영역 하단에 여백 추가 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

