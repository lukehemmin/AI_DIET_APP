<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 프로필 카드 -->
    <include layout="@layout/layout_profile_card" />

    <!-- 이번 주 활동 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="@string/this_week_activity"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <include layout="@layout/layout_weekly_stats" />

    <!-- 최근 획득 배지 -->
    <include layout="@layout/layout_recent_badges" />

    <!-- 메뉴 리스트 -->
    <include layout="@layout/layout_profile_menu" />
</LinearLayout>
